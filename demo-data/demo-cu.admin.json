{"key":"GET /api/rules","method":"GET","path":"/api/rules","query":"","bodyHash":null,"status":200,"contentType":"application/json","body":[{"definition":{"key":"us.complaints.cfpb_clock","jurisdiction":"US","area":"complaints","title":"CFPB complaint portal response clock","summary":"For complaints sent through the CFPB portal: respond within the response period; if that response is not final, give the final response within the final-response period.","appliesTo":"Companies on the CFPB complaint portal, for complaints received through it. Not a general statutory deadline.","fields":[{"name":"responseDays","label":"Response period","type":"integer","min":1,"max":365,"unit":"calendar days"},{"name":"finalResponseDays","label":"Final response period","type":"integer","min":1,"max":365,"unit":"calendar days"}],"defaults":{"responseDays":15,"finalResponseDays":60},"sources":[{"label":"CFPB company complaint process","url":"https://www.consumerfinance.gov/compliance/consumer-complaint-program/company-process/","kind":"primary"}],"sourceNote":"Checked against the CFPB company-process page: 15 calendar days to respond, up to 60 calendar days for a final response.","verification":"primary_source_checked","verifiedOn":"2026-09-25","smeReview":true},"effectiveValue":{"responseDays":15,"finalResponseDays":60},"signedOff":false,"active":null,"pending":null},{"definition":{"key":"us.lending.regb_notice","jurisdiction":"US","area":"lending","title":"Reg B notice of action taken","summary":"Clock from a completed application to the notice of action taken.","appliesTo":"Creditors subject to Regulation B (ECOA).","fields":[{"name":"days","label":"Notice period","type":"integer","min":1,"max":90,"unit":"days"}],"defaults":{"days":30},"sources":[{"label":"12 CFR 1002.9","url":"https://www.consumerfinance.gov/rules-policy/regulations/1002/9/","kind":"primary"}],"sourceNote":"Strategy document ref [125] (Reg B 30-day clock).","verification":"strategy_document","smeReview":true},"effectiveValue":{"days":30},"signedOff":false,"active":null,"pending":null},{"definition":{"key":"us.contact.calling_window","jurisdiction":"US","area":"collections","title":"Customer contact hours (customer's local time)","summary":"Calls only between these hours at the customer's location. Applied as a conduct policy to marketing and collections calls.","appliesTo":"TCPA: telephone solicitations to residential subscribers. Reg F: debt collectors as defined in 12 CFR 1006.2 (generally third parties, not a creditor collecting its own debt in its own name). Confirm state rules.","fields":[{"name":"start","label":"Earliest call","type":"time"},{"name":"end","label":"Latest call","type":"time"}],"defaults":{"start":"08:00","end":"21:00"},"check":"start_before_end","sources":[{"label":"47 CFR 64.1200(c)(1) (TCPA)","url":"https://www.law.cornell.edu/cfr/text/47/64.1200","kind":"primary"},{"label":"12 CFR 1006.6(b)(1)(i) (Reg F)","url":"https://www.law.cornell.edu/cfr/text/12/1006.6","kind":"primary"}],"sourceNote":"Both texts treat calls before 8 a.m. or after 9 p.m. local time as off-limits (TCPA) or presumptively inconvenient (Reg F). Scope differs; see \"Applies to\".","verification":"primary_source_checked","verifiedOn":"2026-09-25","smeReview":true},"effectiveValue":{"start":"08:00","end":"21:00"},"signedOff":false,"active":null,"pending":null}]},
